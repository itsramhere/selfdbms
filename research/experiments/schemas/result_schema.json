{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentRunResult",
  "description": "Output result specification for LSM synchronization benchmark runs",
  "type": "object",
  "required": [
    "schema_version",
    "trial_id",
    "trial_index",
    "workload_id",
    "sync_mode",
    "git_revision",
    "environment",
    "config",
    "timestamps",
    "operations",
    "throughput",
    "latency_read_nanos",
    "lsm_diagnostics",
    "host_diagnostics",
    "fixture_manifest",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "trial_id": {
      "type": "string"
    },
    "trial_index": {
      "type": "integer",
      "minimum": 0
    },
    "workload_id": {
      "type": "string"
    },
    "sync_mode": {
      "type": "string"
    },
    "git_revision": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "kernel",
        "cpu_model",
        "physical_cores",
        "logical_cores",
        "total_ram_bytes",
        "go_version",
        "gomaxprocs",
        "filesystem_type",
        "data_dir_path"
      ],
      "properties": {
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "cpu_model": { "type": "string" },
        "physical_cores": { "type": "integer" },
        "logical_cores": { "type": "integer" },
        "total_ram_bytes": { "type": "integer" },
        "free_ram_bytes": { "type": "integer" },
        "go_version": { "type": "string" },
        "gomaxprocs": { "type": "integer" },
        "filesystem_type": { "type": "string" },
        "data_dir_path": { "type": "string" }
      }
    },
    "config": {
      "type": "object"
    },
    "timestamps": {
      "type": "object",
      "required": [
        "start_iso",
        "finish_iso",
        "warmup_duration_ms",
        "measurement_duration_ms",
        "total_duration_ms"
      ],
      "properties": {
        "start_iso": { "type": "string" },
        "finish_iso": { "type": "string" },
        "warmup_duration_ms": { "type": "integer" },
        "measurement_duration_ms": { "type": "integer" },
        "total_duration_ms": { "type": "integer" }
      }
    },
    "operations": {
      "type": "object",
      "required": [
        "read_ops_attempted",
        "read_ops_completed",
        "expected_hit_count",
        "expected_miss_count",
        "actual_hit_count",
        "actual_miss_count",
        "actual_memtable_hit_count",
        "actual_sstable_hit_count",
        "write_ops_attempted",
        "write_ops_completed",
        "error_ops_count",
        "timeout_ops_count",
        "validation_error_count"
      ],
      "properties": {
        "read_ops_attempted": { "type": "integer" },
        "read_ops_completed": { "type": "integer" },
        "expected_hit_count": { "type": "integer" },
        "expected_miss_count": { "type": "integer" },
        "actual_hit_count": { "type": "integer" },
        "actual_miss_count": { "type": "integer" },
        "actual_memtable_hit_count": { "type": "integer" },
        "actual_sstable_hit_count": { "type": "integer" },
        "write_ops_attempted": { "type": "integer" },
        "write_ops_completed": { "type": "integer" },
        "error_ops_count": { "type": "integer" },
        "timeout_ops_count": { "type": "integer" },
        "validation_error_count": { "type": "integer" }
      }
    },
    "throughput": {
      "type": "object",
      "required": [
        "read_ops_per_sec",
        "write_ops_per_sec",
        "total_ops_per_sec"
      ],
      "properties": {
        "read_ops_per_sec": { "type": "number" },
        "write_ops_per_sec": { "type": "number" },
        "total_ops_per_sec": { "type": "number" }
      }
    },
    "latency_read_nanos": {
      "type": "object",
      "required": [
        "p50",
        "p95",
        "p99",
        "max",
        "min",
        "mean",
        "sample_count",
        "zero_sample_count",
        "overflow_count"
      ],
      "properties": {
        "p50": { "type": "number" },
        "p95": { "type": ["number", "null"] },
        "p99": { "type": ["number", "null"] },
        "p999": { "type": ["number", "null"] },
        "max": { "type": "number" },
        "min": { "type": "number" },
        "mean": { "type": "number" },
        "sample_count": { "type": "integer" },
        "zero_sample_count": { "type": "integer" },
        "overflow_count": { "type": "integer" }
      }
    },
    "latency_write_nanos": {
      "type": "object",
      "properties": {
        "p50": { "type": "number" },
        "p95": { "type": ["number", "null"] },
        "p99": { "type": ["number", "null"] },
        "p999": { "type": ["number", "null"] },
        "max": { "type": "number" },
        "min": { "type": "number" },
        "mean": { "type": "number" },
        "sample_count": { "type": "integer" },
        "zero_sample_count": { "type": "integer" },
        "overflow_count": { "type": "integer" }
      }
    },
    "lsm_diagnostics": {
      "type": "object",
      "required": [
        "initial_sstables",
        "final_sstables",
        "flushes_completed",
        "compactions_completed",
        "sstable_point_reads",
        "memtable_point_reads",
        "measured_flushes",
        "measured_compactions",
        "measured_sstable_point_reads",
        "measured_memtable_point_reads",
        "compaction_active_overlap_ms",
        "reads_during_compaction_count",
        "phase_metrics"
      ],
      "properties": {
        "initial_sstables": { "type": "integer" },
        "final_sstables": { "type": "integer" },
        "flushes_completed": { "type": "integer" },
        "compactions_completed": { "type": "integer" },
        "sstable_point_reads": { "type": "integer" },
        "memtable_point_reads": { "type": "integer" },
        "measured_flushes": { "type": "integer" },
        "measured_compactions": { "type": "integer" },
        "measured_sstable_point_reads": { "type": "integer" },
        "measured_memtable_point_reads": { "type": "integer" },
        "snapshot_seq": { "type": "integer" },
        "active_snapshot_pins": { "type": "integer" },
        "retired_snapshots_count": { "type": "integer" },
        "pending_cleanup_count": { "type": "integer" },
        "live_physical_readers": { "type": "integer" },
        "compaction_active_overlap_ms": { "type": "integer" },
        "reads_during_compaction_count": { "type": "integer" },
        "flush_active_overlap_ms": { "type": "integer" },
        "reads_during_flush_count": { "type": "integer" },
        "attempted_flushes": { "type": "integer" },
        "delayed_flushes": { "type": "integer" },
        "phase_metrics": {
          "type": "object",
          "required": [
            "fixture_setup",
            "warmup",
            "measured",
            "cooldown",
            "shutdown"
          ],
          "properties": {
            "fixture_setup": { "$ref": "#/$defs/PhaseCounters" },
            "warmup": { "$ref": "#/$defs/PhaseCounters" },
            "measured": { "$ref": "#/$defs/PhaseCounters" },
            "cooldown": { "$ref": "#/$defs/PhaseCounters" },
            "shutdown": { "$ref": "#/$defs/PhaseCounters" }
          }
        }
      }
    },
    "host_diagnostics": {
      "type": "object",
      "required": [
        "heap_alloc_bytes",
        "heap_sys_bytes",
        "num_gc",
        "gc_pause_total_ns"
      ],
      "properties": {
        "heap_alloc_bytes": { "type": "integer" },
        "heap_sys_bytes": { "type": "integer" },
        "num_gc": { "type": "integer" },
        "gc_pause_total_ns": { "type": "integer" }
      }
    },
    "fixture_manifest": {
      "type": "object",
      "required": [
        "committed_keys",
        "expected_sstable_count",
        "actual_sstable_count",
        "flush_errors",
        "validation_readback_status",
        "initialization_duration_ms"
      ],
      "properties": {
        "committed_keys": { "type": "integer" },
        "expected_sstable_count": { "type": "integer" },
        "actual_sstable_count": { "type": "integer" },
        "flush_errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validation_readback_status": { "type": "string" },
        "initialization_duration_ms": { "type": "integer" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "EXCLUDED"]
    },
    "exclusion_reason": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "PhaseCounters": {
      "type": "object",
      "required": [
        "start_flushes",
        "end_flushes",
        "delta_flushes",
        "start_compactions",
        "end_compactions",
        "delta_compactions",
        "start_sstable_reads",
        "end_sstable_reads",
        "delta_sstable_reads",
        "start_memtable_reads",
        "end_memtable_reads",
        "delta_memtable_reads"
      ],
      "properties": {
        "start_flushes": { "type": "integer" },
        "end_flushes": { "type": "integer" },
        "delta_flushes": { "type": "integer" },
        "start_compactions": { "type": "integer" },
        "end_compactions": { "type": "integer" },
        "delta_compactions": { "type": "integer" },
        "start_sstable_reads": { "type": "integer" },
        "end_sstable_reads": { "type": "integer" },
        "delta_sstable_reads": { "type": "integer" },
        "start_memtable_reads": { "type": "integer" },
        "end_memtable_reads": { "type": "integer" },
        "delta_memtable_reads": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
