{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentRunConfig",
  "description": "Configuration specification for LSM synchronization benchmark runs",
  "type": "object",
  "required": [
    "schema_version",
    "workload_id",
    "sync_mode",
    "seed",
    "reader_concurrency",
    "writer_concurrency",
    "measurement_duration_ms",
    "warmup_duration_ms",
    "key_size_bytes",
    "val_size_bytes",
    "keyspace_cardinality",
    "initial_sstable_count",
    "initial_keys_per_sstable",
    "read_distribution",
    "target_read_hit_ratio",
    "memtable_threshold_bytes",
    "data_dir",
    "wal_sync"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "trial_id": {
      "type": "string"
    },
    "trial_index": {
      "type": "integer",
      "minimum": 0
    },
    "workload_id": {
      "type": "string",
      "enum": [
        "WORKLOAD_A_READ_ONLY",
        "WORKLOAD_B_MIXED_FLUSH",
        "WORKLOAD_B1_NATURAL_WRITE_PROGRESS",
        "WORKLOAD_B2_CONTROLLED_FLUSH_INTERFERENCE",
        "WORKLOAD_C_COMPACTION_OVERLAP",
        "WORKLOAD_D_READER_CHURN",
        "WORKLOAD_E_NEGATIVE_CONTROL_MEMTABLE"
      ]
    },
    "sync_mode": {
      "type": "string",
      "enum": ["ApproachA_RWMutexBaseline", "ApproachB_ReaderSnapshot"]
    },
    "seed": {
      "type": "integer"
    },
    "reader_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "writer_concurrency": {
      "type": "integer",
      "minimum": 0
    },
    "flush_trigger_interval_ms": {
      "type": "integer",
      "minimum": 0
    },
    "measurement_duration_ms": {
      "type": "integer",
      "minimum": 100
    },
    "warmup_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cooldown_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "key_size_bytes": {
      "type": "integer",
      "minimum": 8
    },
    "val_size_bytes": {
      "type": "integer",
      "minimum": 8
    },
    "keyspace_cardinality": {
      "type": "integer",
      "minimum": 1
    },
    "initial_sstable_count": {
      "type": "integer",
      "minimum": 0
    },
    "initial_keys_per_sstable": {
      "type": "integer",
      "minimum": 0
    },
    "read_distribution": {
      "type": "string",
      "enum": ["uniform", "zipfian_skewed"]
    },
    "zipf_s": {
      "type": "number",
      "description": "Zipfian skew factor (typically 0.99 for 80/20 power-law skew)"
    },
    "target_read_hit_ratio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "memtable_threshold_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "data_dir": {
      "type": "string"
    },
    "wal_sync": {
      "type": "boolean"
    },
    "compaction_trigger_interval_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
