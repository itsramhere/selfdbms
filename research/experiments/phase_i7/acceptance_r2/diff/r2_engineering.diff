diff --git a/lsmengine/sync_instrumentation.go b/lsmengine/sync_instrumentation.go
new file mode 100644
index 0000000..675fcd6
--- /dev/null
+++ b/lsmengine/sync_instrumentation.go
@@ -0,0 +1,234 @@
+package lsmengine
+
+// Non-invasive synchronization instrumentation (Phase I7 engineering preflight,
+// R1.2e §3.2 and the R2 engineering authorization).
+//
+// Contract:
+//
+//  1. Zero production footprint. SyncObserver is nil unless a caller attaches
+//     one, and every instrumented site pays exactly one nil-pointer check.
+//     Attaching an observer never changes engine behavior, ordering, or
+//     outcomes; observers must be non-blocking and lock-free.
+//
+//  2. Honest timestamps. Durations are only ever measured with a caller
+//     supplied monotonic nanosecond clock. SetSyncObserver refuses an observer
+//     without a clock so that coarse wall-clock time (on Windows time.Now
+//     advances in ~0.5 ms steps) can never silently quantise microsecond-level
+//     synchronization events to zero. The I7 harness injects the QPC clock,
+//     which shares one monotonic timeline with the trial measurement window.
+//
+//  3. Active read-holder counting (R1.2e §3.2). activeRLockHolders counts
+//     goroutines between rLock() and rUnlock() on Manager.Mu. Per the
+//     pre-registered sketch the increment happens BEFORE Mu.RLock() and the
+//     decrement AFTER Mu.RUnlock(). The counter therefore satisfies
+//     counter >= (true holders) at every instant — it can overcount by readers
+//     that have incremented but not yet acquired, and by readers that have
+//     released the RWMutex but not yet decremented — and can never undercount.
+//     It is a sampled diagnostic, not a linearizable snapshot: between a
+//     writer's Load() of the counter and its Mu.Lock() the holder set may
+//     change arbitrarily. These limitations are restated in the checkpoint
+//     document that defines the EXP-2 arrival sampling semantics.
+//
+//  4. Scope. Only Manager.Mu participates: Approach B's snapshotMu pin count
+//     and Approach A-min's per-table lease counts are separate mechanisms and
+//     are NOT part of activeRLockHolders. Writer-lock wait and publication
+//     hold are instrumented at Transaction.Commit, the flush publication
+//     (all three modes) and the A/A-min compaction publication. Secondary
+//     writer sites (TriggerFlush, checkAndTriggerFlush, SetMemtableThresholdBytes,
+//     Close, Approach B compaction's snapshotMu swap) are deliberately
+//     uninstrumented and are listed as uncovered in the checkpoint.
+
+import (
+	"errors"
+)
+
+// SyncObserver receives synchronization instrumentation from the Manager.
+// Implementations must be non-blocking, lock-free, allocation-free and
+// thread-safe; they are invoked on the hot-path goroutines of readers,
+// writers and flush workers.
+type SyncObserver interface {
+	// OnReadCriticalSection reports one completed read request and the duration
+	// of its Manager.Mu read critical section (from RLock acquisition to
+	// RUnlock release). mode identifies the read path observed:
+	//   - SyncModeApproachA:     the critical section spans the entire read.
+	//   - SyncModeApproachAMin:  the critical section spans only the
+	//                            memory-tier probe + lease-capture window;
+	//                            the SSTable scan runs unlocked afterwards.
+	//   - SyncModeApproachB:     the critical section spans the memory-tier
+	//                            probe + snapshot pin; the disk scan runs
+	//                            unlocked afterwards.
+	OnReadCriticalSection(mode SyncMode, durationNs int64)
+
+	// OnWriterLockWait reports one writer arrival at Manager.Mu for writing.
+	// waitNs is the interval between the arrival sample and completed
+	// acquisition (including the uncontended fast path, so the observed wait
+	// has a timer-overhead floor of roughly two clock reads).
+	// holdersAtArrival is the activeRLockHolders sample taken immediately
+	// before the Lock attempt (see the overcounting caveat above).
+	OnWriterLockWait(site LockSite, waitNs int64, holdersAtArrival int32)
+
+	// OnPublication reports one exclusive publication critical section (the
+	// swap-in of a flushed or compacted SSTable). durationNs is the strict
+	// exclusive hold time measured from acquisition to release;
+	// holdersAtArrival is the arrival sample taken before the Lock attempt.
+	OnPublication(site LockSite, durationNs int64, holdersAtArrival int32)
+}
+
+// LockSite identifies the writer path that produced an observation.
+type LockSite int
+
+const (
+	// LockSiteCommit is Transaction.Commit's validation + apply critical section.
+	LockSiteCommit LockSite = iota
+	// LockSiteFlushPublish is the flush worker's SSTable publication section
+	// in flushToDisk (all synchronization modes).
+	LockSiteFlushPublish
+	// LockSiteCompactionPublish is CompactAll's identity-preserving swap-in
+	// for Approach A and A-min. The Approach B compaction publishes through
+	// snapshotMu and is not instrumented.
+	LockSiteCompactionPublish
+)
+
+func (s LockSite) String() string {
+	switch s {
+	case LockSiteCommit:
+		return "commit"
+	case LockSiteFlushPublish:
+		return "flush_publish"
+	case LockSiteCompactionPublish:
+		return "compaction_publish"
+	default:
+		return "unknown"
+	}
+}
+
+// SetSyncObserver attaches instrumentation. clock must be a monotonic
+// nanosecond function (the I7 harness injects the Windows QPC clock). Passing
+// a nil observer detaches instrumentation. An observer without a clock is
+// rejected: durations measured on a coarse wall clock would be silently
+// quantised. The observer must be attached before concurrent engine use; the
+// fields are otherwise read without synchronization on the hot paths.
+func (m *Manager) SetSyncObserver(obs SyncObserver, clock func() int64) error {
+	if obs != nil && clock == nil {
+		return errors.New("sync instrumentation requires a monotonic nanosecond clock")
+	}
+	m.syncObserver = obs
+	m.instrumentClock = clock
+	return nil
+}
+
+// ActiveRLockHolders returns the current count of goroutines between rLock and
+// rUnlock on Manager.Mu (see the overcounting caveat in this file's header).
+func (m *Manager) ActiveRLockHolders() int32 {
+	return m.activeRLockHolders.Load()
+}
+
+// rLock is the single read-path entry point for Manager.Mu. Per the
+// pre-registered R1.2e sketch the holder count is incremented before the
+// RLock, so the counter is a one-sided (never-undercounting) estimate.
+func (m *Manager) rLock() {
+	m.activeRLockHolders.Add(1)
+	m.Mu.RLock()
+}
+
+// rUnlock is the single read-path exit point for Manager.Mu.
+func (m *Manager) rUnlock() {
+	m.Mu.RUnlock()
+	m.activeRLockHolders.Add(-1)
+}
+
+// readCSStart returns a timestamp for critical-section timing, or 0 when no
+// observer is attached (the value is then meaningless and never used).
+func (m *Manager) readCSStart() int64 {
+	if m.syncObserver == nil {
+		return 0
+	}
+	return m.instrumentClock()
+}
+
+// rUnlockObserved releases the read lock and, when instrumentation is
+// attached, reports the read critical-section duration since startNs.
+// All read-path exits must use this or rUnlock; nothing may call
+// m.Mu.RUnlock() directly, or the holder counter drifts.
+func (m *Manager) rUnlockObserved(mode SyncMode, startNs int64) {
+	if m.syncObserver != nil {
+		d := m.instrumentClock() - startNs
+		if d < 0 {
+			d = 0
+		}
+		m.syncObserver.OnReadCriticalSection(mode, d)
+	}
+	m.rUnlock()
+}
+
+// writerLockObs is the arrival record for one writer Lock attempt. The zero
+// value is inert: when no observer is attached both methods are no-ops and
+// the site costs nothing beyond the nil check.
+type writerLockObs struct {
+	site     LockSite
+	startNs  int64
+	holders  int32
+	observed bool
+}
+
+// writerLockArrival samples the active holder count and start time
+// immediately before a writer lock attempt.
+func (m *Manager) writerLockArrival(site LockSite) writerLockObs {
+	if m.syncObserver == nil {
+		return writerLockObs{}
+	}
+	return writerLockObs{
+		site:     site,
+		startNs:  m.instrumentClock(),
+		holders:  m.activeRLockHolders.Load(),
+		observed: true,
+	}
+}
+
+// acquired reports the wait once Manager.Mu has been acquired for writing.
+func (w *writerLockObs) acquired(m *Manager) {
+	if !w.observed {
+		return
+	}
+	d := m.instrumentClock() - w.startNs
+	if d < 0 {
+		d = 0
+	}
+	m.syncObserver.OnWriterLockWait(w.site, d, w.holders)
+}
+
+// publicationObs times one exclusive publication hold. The zero value is inert.
+type publicationObs struct {
+	site     LockSite
+	startNs  int64
+	holders  int32
+	observed bool
+}
+
+// beginPublication starts timing an exclusive publication hold immediately
+// after Manager.Mu has been acquired for writing. holdersAtArrival must be
+// the arrival sample from the writerLockArrival that preceded the Lock.
+func (m *Manager) beginPublication(site LockSite, holdersAtArrival int32) publicationObs {
+	if m.syncObserver == nil {
+		return publicationObs{}
+	}
+	return publicationObs{
+		site:     site,
+		startNs:  m.instrumentClock(),
+		holders:  holdersAtArrival,
+		observed: true,
+	}
+}
+
+// end reports the publication hold; call it while the lock is still held,
+// immediately before the release.
+func (p *publicationObs) end(m *Manager) {
+	if !p.observed {
+		return
+	}
+	d := m.instrumentClock() - p.startNs
+	if d < 0 {
+		d = 0
+	}
+	m.syncObserver.OnPublication(p.site, d, p.holders)
+}
diff --git a/lsmengine/sync_instrumentation_test.go b/lsmengine/sync_instrumentation_test.go
new file mode 100644
index 0000000..e335972
--- /dev/null
+++ b/lsmengine/sync_instrumentation_test.go
@@ -0,0 +1,440 @@
+package lsmengine
+
+// Deterministic tests for the Phase I7 synchronization instrumentation.
+//
+// Timing assertions use a synthetic clock that advances by a fixed step on
+// every read, so observed durations are exact integer multiples of the step
+// and the tests are immune to scheduler noise. No wall-clock duration is ever
+// asserted.
+
+import (
+	"fmt"
+	"math"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// stepClock advances by step on every call, producing exact durations.
+type stepClock struct {
+	now  atomic.Int64
+	step int64
+}
+
+func (c *stepClock) Now() int64 { return c.now.Add(c.step) }
+
+// rec is one writer-wait or publication observation.
+type rec struct {
+	site    LockSite
+	waitNs  int64
+	holders int32
+}
+
+// recordingObserver is a mutex-guarded SyncObserver for single-shot assertions.
+type recordingObserver struct {
+	mu          sync.Mutex
+	readCS      map[SyncMode][]int64
+	waits       []rec
+	pubs        []rec
+	publishHold []int
+
+	publishBegan chan struct{}
+	once         sync.Once
+}
+
+func newRecordingObserver() *recordingObserver {
+	return &recordingObserver{
+		readCS:       map[SyncMode][]int64{},
+		publishBegan: make(chan struct{}, 64),
+	}
+}
+
+func (o *recordingObserver) OnReadCriticalSection(mode SyncMode, durationNs int64) {
+	o.mu.Lock()
+	o.readCS[mode] = append(o.readCS[mode], durationNs)
+	o.mu.Unlock()
+}
+
+func (o *recordingObserver) OnWriterLockWait(site LockSite, waitNs int64, holders int32) {
+	o.mu.Lock()
+	o.waits = append(o.waits, rec{site: site, waitNs: waitNs, holders: holders})
+	o.mu.Unlock()
+}
+
+func (o *recordingObserver) OnPublication(site LockSite, durationNs int64, holders int32) {
+	o.mu.Lock()
+	o.pubs = append(o.pubs, rec{site: site, waitNs: durationNs, holders: holders})
+	o.mu.Unlock()
+}
+
+func (o *recordingObserver) OnFlushPublishBegin(activeRLockHolders int) {
+	o.mu.Lock()
+	o.publishHold = append(o.publishHold, activeRLockHolders)
+	o.mu.Unlock()
+	o.once.Do(func() { close(o.publishBegan) })
+}
+
+// Unused FlushObserver callbacks (recordingObserver doubles as one so tests
+// can capture the publication arrival sample).
+func (o *recordingObserver) OnFlushRequested()           {}
+func (o *recordingObserver) OnFlushAdmitted(bool, error) {}
+func (o *recordingObserver) OnFlushWorkerBegin()         {}
+func (o *recordingObserver) OnFlushBuildBegin()          {}
+func (o *recordingObserver) OnFlushBuildEnd(error)       {}
+func (o *recordingObserver) OnFlushPublishEnd(error)     {}
+func (o *recordingObserver) OnFlushComplete(error)       {}
+
+var _ SyncObserver = (*recordingObserver)(nil)
+var _ FlushObserver = (*recordingObserver)(nil)
+
+func newInstrumentedManager(t *testing.T, mode SyncMode, clock *stepClock) (*Manager, *recordingObserver) {
+	t.Helper()
+	man, err := CreateManagerWithConfig(Config{
+		Mode:    mode,
+		WalPath: filepath.Join(t.TempDir(), "wal.log"),
+		DataDir: t.TempDir(),
+	})
+	if err != nil {
+		t.Fatalf("create manager: %v", err)
+	}
+	obs := newRecordingObserver()
+	if err := man.SetSyncObserver(obs, clock.Now); err != nil {
+		t.Fatalf("set sync observer: %v", err)
+	}
+	// The observer also listens to flush phases so tests can capture the
+	// publication arrival sample.
+	man.SetFlushObserver(obs)
+	t.Cleanup(func() { _ = man.Close() })
+	return man, obs
+}
+
+func waitForCond(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// TestSetSyncObserverRequiresClock is the fail-closed error path: instrumentation
+// without a monotonic clock must be refused, never silently degraded to a
+// coarse wall clock.
+func TestSetSyncObserverRequiresClock(t *testing.T) {
+	man, err := CreateManagerWithConfig(Config{Mode: SyncModeApproachA, WalPath: filepath.Join(t.TempDir(), "wal.log")})
+	if err != nil {
+		t.Fatalf("create manager: %v", err)
+	}
+	defer func() { _ = man.Close() }()
+	if err := man.SetSyncObserver(newRecordingObserver(), nil); err == nil {
+		t.Fatal("expected rejection of an observer without a clock")
+	}
+	if man.syncObserver != nil {
+		t.Fatal("rejected observer must not be attached")
+	}
+	// A nil observer with a nil clock is a valid detach call.
+	if err := man.SetSyncObserver(nil, nil); err != nil {
+		t.Fatalf("detach failed: %v", err)
+	}
+}
+
+// TestActiveRLockHoldersAllModes verifies that the holder counter tracks
+// readers parked inside the read critical section, for each of the three
+// synchronization architectures, and returns to zero after they leave.
+func TestActiveRLockHoldersAllModes(t *testing.T) {
+	for _, mode := range []SyncMode{SyncModeApproachA, SyncModeApproachAMin, SyncModeApproachB} {
+		t.Run(mode.String(), func(t *testing.T) {
+			man, _ := newInstrumentedManager(t, mode, &stepClock{step: 1})
+			tx := man.Begin()
+			tx.Put("k0", "v0")
+			if err := tx.Commit(); err != nil {
+				t.Fatalf("commit: %v", err)
+			}
+
+			var enteredOnce sync.Once
+			entered := make(chan struct{})
+			release := make(chan struct{})
+			man.duringMemtableReadHook = func() {
+				enteredOnce.Do(func() { close(entered) })
+				<-release
+			}
+
+			const readers = 4
+			var wg sync.WaitGroup
+			for i := 0; i < readers; i++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					_, _ = man.Get(fmt.Sprintf("k%d", i), math.MaxUint64)
+				}()
+			}
+			<-entered
+			waitForCond(t, "holders to reach 4", func() bool { return man.ActiveRLockHolders() == readers })
+			close(release)
+			wg.Wait()
+			waitForCond(t, "holders to return to 0", func() bool { return man.ActiveRLockHolders() == 0 })
+		})
+	}
+}
+
+// TestReadCriticalSectionObservedAllModes verifies one observed read per mode
+// with an exact synthetic duration.
+func TestReadCriticalSectionObservedAllModes(t *testing.T) {
+	const step = 100
+	for _, mode := range []SyncMode{SyncModeApproachA, SyncModeApproachAMin, SyncModeApproachB} {
+		t.Run(mode.String(), func(t *testing.T) {
+			clock := &stepClock{step: step}
+			man, obs := newInstrumentedManager(t, mode, clock)
+			tx := man.Begin()
+			tx.Put("k0", "v0")
+			if err := tx.Commit(); err != nil {
+				t.Fatalf("commit: %v", err)
+			}
+			obs.mu.Lock()
+			baseReads := len(obs.readCS[mode])
+			obs.mu.Unlock()
+
+			if _, err := man.Get("k0", math.MaxUint64); err != nil {
+				t.Fatalf("get: %v", err)
+			}
+			obs.mu.Lock()
+			got := obs.readCS[mode]
+			obs.mu.Unlock()
+			if len(got) != baseReads+1 {
+				t.Fatalf("expected %d observed read critical sections, got %d", baseReads+1, len(got))
+			}
+			d := got[len(got)-1]
+			// start + end = two clock reads -> exactly one step of duration.
+			if d != step {
+				t.Fatalf("read critical section = %d ns, want exactly %d ns (synthetic clock step)", d, step)
+			}
+		})
+	}
+}
+
+// TestWriterWaitAndPublicationObservedAllModes verifies the commit wait and
+// the flush publication hold, with exact synthetic durations and a zero
+// holder sample on a quiescent engine.
+func TestWriterWaitAndPublicationObservedAllModes(t *testing.T) {
+	const step = 100
+	for _, mode := range []SyncMode{SyncModeApproachA, SyncModeApproachAMin, SyncModeApproachB} {
+		t.Run(mode.String(), func(t *testing.T) {
+			clock := &stepClock{step: step}
+			man, obs := newInstrumentedManager(t, mode, clock)
+
+			tx := man.Begin()
+			tx.Put("k0", "v0")
+			if err := tx.Commit(); err != nil {
+				t.Fatalf("commit: %v", err)
+			}
+			if err := man.TriggerFlush(); err != nil {
+				t.Fatalf("trigger flush: %v", err)
+			}
+			if err := man.WaitForFlushCompletion(); err != nil {
+				t.Fatalf("flush: %v", err)
+			}
+
+			obs.mu.Lock()
+			defer obs.mu.Unlock()
+			// Two writer arrivals are expected: the commit and the flush
+			// worker's arrival at the publication lock.
+			if len(obs.waits) != 2 {
+				t.Fatalf("expected 2 writer waits (commit + flush publish), got %d: %+v", len(obs.waits), obs.waits)
+			}
+			commitWaits := 0
+			for _, w := range obs.waits {
+				switch w.site {
+				case LockSiteCommit:
+					commitWaits++
+					if w.waitNs != step || w.holders != 0 {
+						t.Fatalf("commit wait = %+v, want wait=%d holders=0", w, step)
+					}
+				case LockSiteFlushPublish:
+					if w.waitNs != step || w.holders != 0 {
+						t.Fatalf("flush publish wait = %+v, want wait=%d holders=0", w, step)
+					}
+				default:
+					t.Fatalf("unexpected lock site %v", w.site)
+				}
+			}
+			if commitWaits != 1 {
+				t.Fatalf("expected exactly 1 commit wait, got %d", commitWaits)
+			}
+			if len(obs.pubs) != 1 {
+				t.Fatalf("expected 1 publication, got %d: %+v", len(obs.pubs), obs.pubs)
+			}
+			p := obs.pubs[0]
+			if p.site != LockSiteFlushPublish || p.waitNs != step || p.holders != 0 {
+				t.Fatalf("publication = %+v, want site=flush_publish hold=%d holders=0", p, step)
+			}
+		})
+	}
+}
+
+// TestPublicationArrivalSampleCountsBlockedReaders verifies the pre-registered
+// R1.2e §3.2 arrival sampling: a reader parked inside its read critical
+// section when the flush worker arrives at the publication lock must appear
+// in the OnFlushPublishBegin sample.
+//
+// Deterministic staging: the flush worker is parked in beforeFlushPublishHook
+// (which runs outside Manager.Mu) while the reader parks inside its read
+// critical section; releasing the worker then makes it sample the holder
+// counter before contending on Manager.Mu with the parked reader.
+func TestPublicationArrivalSampleCountsBlockedReaders(t *testing.T) {
+	clock := &stepClock{step: 100}
+	man, obs := newInstrumentedManager(t, SyncModeApproachA, clock)
+
+	tx := man.Begin()
+	tx.Put("k0", "v0")
+	if err := tx.Commit(); err != nil {
+		t.Fatalf("commit: %v", err)
+	}
+
+	// Park the flush worker immediately before the publication section.
+	workerParked := make(chan struct{})
+	releaseWorker := make(chan struct{})
+	var parkOnce sync.Once
+	man.beforeFlushPublishHook = func() {
+		parkOnce.Do(func() { close(workerParked) })
+		<-releaseWorker
+	}
+	if err := man.TriggerFlush(); err != nil {
+		t.Fatalf("trigger flush: %v", err)
+	}
+	<-workerParked
+
+	// Park one reader inside its read critical section.
+	var enteredOnce sync.Once
+	entered := make(chan struct{})
+	releaseReader := make(chan struct{})
+	man.duringMemtableReadHook = func() {
+		enteredOnce.Do(func() { close(entered) })
+		<-releaseReader
+	}
+	readerDone := make(chan struct{})
+	go func() {
+		defer close(readerDone)
+		_, _ = man.Get("k1", math.MaxUint64)
+	}()
+	<-entered
+	waitForCond(t, "holder to be counted", func() bool { return man.ActiveRLockHolders() == 1 })
+
+	// Release the worker: it samples the holders at publication arrival, then
+	// contends on Manager.Mu with the parked reader.
+	close(releaseWorker)
+	select {
+	case <-obs.publishBegan:
+	case <-time.After(5 * time.Second):
+		t.Fatal("publication never began")
+	}
+	obs.mu.Lock()
+	got := append([]int(nil), obs.publishHold...)
+	obs.mu.Unlock()
+	if len(got) == 0 {
+		t.Fatal("OnFlushPublishBegin was not observed")
+	}
+	if got[len(got)-1] != 1 {
+		t.Fatalf("arrival sample = %d, want 1 blocked reader", got[len(got)-1])
+	}
+	close(releaseReader)
+	<-readerDone
+	if err := man.WaitForFlushCompletion(); err != nil {
+		t.Fatalf("flush: %v", err)
+	}
+}
+
+// TestCompactionPublicationObserved verifies the compaction publication hold
+// observation for Approach A (identity-preserving swap-in).
+func TestCompactionPublicationObserved(t *testing.T) {
+	const step = 100
+	clock := &stepClock{step: step}
+	man, obs := newInstrumentedManager(t, SyncModeApproachA, clock)
+	for i := 0; i < 3; i++ {
+		tx := man.Begin()
+		tx.Put(fmt.Sprintf("k%d", i), "v")
+		if err := tx.Commit(); err != nil {
+			t.Fatalf("commit %d: %v", i, err)
+		}
+		if err := man.TriggerFlush(); err != nil {
+			t.Fatalf("flush %d: %v", i, err)
+		}
+	}
+	if err := man.WaitForFlushCompletion(); err != nil {
+		t.Fatalf("flushes: %v", err)
+	}
+	if err := man.CompactAll(); err != nil {
+		t.Fatalf("compact: %v", err)
+	}
+	obs.mu.Lock()
+	defer obs.mu.Unlock()
+	var pubs []rec
+	for _, p := range obs.pubs {
+		if p.site == LockSiteCompactionPublish {
+			pubs = append(pubs, p)
+		}
+	}
+	if len(pubs) != 1 {
+		t.Fatalf("expected exactly 1 compaction publication, got %d (%+v)", len(pubs), obs.pubs)
+	}
+	if pubs[0].waitNs != step {
+		t.Fatalf("compaction publication hold = %d, want %d", pubs[0].waitNs, step)
+	}
+}
+
+// TestHolderCounterNeverNegative guards the counter invariant under
+// concurrent readers and writers with no instrumentation attached.
+func TestHolderCounterNeverNegative(t *testing.T) {
+	man, err := CreateManagerWithConfig(Config{Mode: SyncModeApproachAMin, WalPath: filepath.Join(t.TempDir(), "wal.log"), DataDir: t.TempDir()})
+	if err != nil {
+		t.Fatalf("create manager: %v", err)
+	}
+	defer func() { _ = man.Close() }()
+	tx := man.Begin()
+	tx.Put("k", "v")
+	if err := tx.Commit(); err != nil {
+		t.Fatalf("commit: %v", err)
+	}
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+					_, _ = man.Get("k", math.MaxUint64)
+				}
+			}
+		}()
+	}
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 200; i++ {
+			wtx := man.Begin()
+			wtx.Put("k", fmt.Sprintf("v%d", i))
+			_ = wtx.Commit()
+		}
+	}()
+	deadline := time.Now().Add(500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		if h := man.ActiveRLockHolders(); h < 0 {
+			close(stop)
+			wg.Wait()
+			t.Fatalf("active holder counter went negative: %d", h)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	close(stop)
+	wg.Wait()
+	if h := man.ActiveRLockHolders(); h != 0 {
+		t.Fatalf("holder counter did not drain to 0: %d", h)
+	}
+}
