diff --git a/research/experiments/phase_i7/cmd/i7trial/main_test.go b/research/experiments/phase_i7/cmd/i7trial/main_test.go
new file mode 100644
index 0000000..526931c
--- /dev/null
+++ b/research/experiments/phase_i7/cmd/i7trial/main_test.go
@@ -0,0 +1,185 @@
+package main
+
+// Unit tests for the i7trial dispatch surface (Phase I7 engineering preflight).
+// These tests cover block dispatch and envelope validation only; they never
+// execute a trial.
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"owndbms/research/experiments/phase_i7/harness2"
+)
+
+// TestD3BlockIsDispatchable is the regression test for the D3
+// runner-dispatch correction (R1.2e §6 item 1): a drift-anchor row in the
+// runlist must be accepted by this runner, resolved to the closed-loop mode,
+// and never mistaken for a separate-runner block.
+func TestD3BlockIsDispatchable(t *testing.T) {
+	if !containsFold(supportedBlocks, "D3") {
+		t.Fatal("D3 missing from supportedBlocks: runlists with drift anchors would be rejected")
+	}
+	for _, b := range separateRunnerBlocks {
+		if strings.EqualFold(b, "D3") {
+			t.Fatal("D3 must not be dispatched to the separate pebble_runner")
+		}
+	}
+	spec := harness2.Spec{
+		Schema:  "i7.trial-spec.v1",
+		TrialID: "d3_anchor",
+		Block:   "D3",
+		Cell:    "C2-01",
+		Arm:     "A",
+	}
+	mode, err := spec.ResolveMode()
+	if err != nil {
+		t.Fatalf("D3 spec must resolve: %v", err)
+	}
+	if mode != harness2.ModeClosedLoop {
+		t.Fatalf("D3 must resolve to closed-loop mode, got %v", mode)
+	}
+}
+
+// TestSupportedBlocksComplete locks the full dispatch surface.
+func TestSupportedBlocksComplete(t *testing.T) {
+	want := []string{"E1", "E2", "E3", "E4", "E5", "D3", "PF", "SMOKE"}
+	if len(supportedBlocks) != len(want) {
+		t.Fatalf("supportedBlocks = %v, want %v", supportedBlocks, want)
+	}
+	for _, b := range want {
+		if !containsFold(supportedBlocks, b) {
+			t.Fatalf("supportedBlocks missing %q", b)
+		}
+	}
+	// E7 is owned by pebble_runner and must stay rejected here.
+	if containsFold(supportedBlocks, "E7") {
+		t.Fatal("E7 must not be dispatchable by i7trial")
+	}
+}
+
+func validEnvelope() *Envelope {
+	e := &Envelope{
+		Schema:  "i7.trial.v1",
+		TrialID: "t1",
+		Block:   "D3",
+		Arm:     "A",
+		Status:  "SUCCESS",
+		Result: &harness2.TrialResult{
+			TrialID: "t1",
+			Operations: harness2.OperationCounts{
+				ReadOpsCompleted: 10,
+			},
+		},
+	}
+	e.Result.Timestamps.MeasuredWindowNs = 1
+	return e
+}
+
+// TestCheckApprovalBindings covers the approval-binding refusals at the
+// runner level (the driver-level scenarios of the G2 orchestration suite
+// became revocation assertions when the legacy execution authority was
+// removed): campaign, protocol, gate, runner hash, and block-set bindings
+// must all match or execution is refused.
+func TestCheckApprovalBindings(t *testing.T) {
+	selfHash := runtimeInfo().ExeSHA256
+	if selfHash == "" {
+		t.Skip("runner self-hash unavailable in this environment")
+	}
+
+	write := func(t *testing.T, mutate func(a *Approval)) string {
+		t.Helper()
+		a := Approval{
+			CampaignID:      campaignID,
+			ProtocolVersion: protocolVersion,
+			Gate:            "G4",
+			Approved:        true,
+			ApprovedBy:      "unit-test",
+			ApprovedAt:      "2026-10-29T00:00:00Z",
+			Scope:           "SYNTHETIC - unit test only",
+			RunlistSHA256:   "0f6076500a56a05b4a1c1b5b8b1c9b5f4f3e2d1c0b9a8a7b6c5d4e3f2a1b0c9d",
+			RunnerSHA256:    selfHash,
+			AllowedBlocks:   []string{"D3", "E1"},
+			AllowedPhases:   []string{"confirmatory", "drift_anchor"},
+			MaxTrials:       400,
+			AllowDirty:      true,
+		}
+		if mutate != nil {
+			mutate(&a)
+		}
+		path := filepath.Join(t.TempDir(), "APPROVAL.json")
+		b, err := json.Marshal(a)
+		if err != nil {
+			t.Fatalf("marshal approval: %v", err)
+		}
+		if err := os.WriteFile(path, b, 0o644); err != nil {
+			t.Fatalf("write approval: %v", err)
+		}
+		return path
+	}
+
+	// The fully valid approval must pass for an approved block.
+	if _, err := checkApproval(write(t, nil), "G4", "D3"); err != nil {
+		t.Fatalf("valid approval rejected: %v", err)
+	}
+
+	cases := map[string]func(a *Approval){
+		"not approved":       func(a *Approval) { a.Approved = false },
+		"wrong campaign":     func(a *Approval) { a.CampaignID = "OTHER" },
+		"wrong protocol":     func(a *Approval) { a.ProtocolVersion = "0.0.1" },
+		"wrong gate":         func(a *Approval) { a.Gate = "G3" },
+		"wrong runner hash":  func(a *Approval) { a.RunnerSHA256 = strings.Repeat("0", 64) },
+		"empty runner hash":  func(a *Approval) { a.RunnerSHA256 = "" },
+		"empty block set":    func(a *Approval) { a.AllowedBlocks = nil },
+		"block not approved": func(a *Approval) { a.AllowedBlocks = []string{"E1"} },
+	}
+	for name, mutate := range cases {
+		if _, err := checkApproval(write(t, mutate), "G4", "D3"); err == nil {
+			t.Fatalf("%s: expected checkApproval to refuse", name)
+		}
+	}
+
+	// Missing gate or approval file refuse outright.
+	if _, err := checkApproval("", "G4", "D3"); err == nil {
+		t.Fatal("missing gate accepted")
+	}
+	if _, err := checkApproval(filepath.Join(t.TempDir(), "missing.json"), "G4", "D3"); err == nil {
+		t.Fatal("missing approval file accepted")
+	}
+}
+
+// TestValidateEnvelopeErrorPaths covers the fail-closed envelope checks that
+// keep malformed records out of the ledger.
+func TestValidateEnvelopeErrorPaths(t *testing.T) {
+	valid := validEnvelope()
+	if err := validateEnvelope(valid); err != nil {
+		t.Fatalf("valid envelope rejected: %v", err)
+	}
+
+	cases := map[string]func(e *Envelope){
+		"schema mismatch":     func(e *Envelope) { e.Schema = "other" },
+		"missing identity":    func(e *Envelope) { e.TrialID = "" },
+		"missing result":      func(e *Envelope) { e.Result = nil },
+		"result id mismatch":  func(e *Envelope) { e.Result.TrialID = "other" },
+		"zero completed rows": func(e *Envelope) { e.Result.Operations.ReadOpsCompleted = 0 },
+		"zero window":         func(e *Envelope) { e.Result.Timestamps.MeasuredWindowNs = 0 },
+		"validation errors":   func(e *Envelope) { e.Result.Operations.ValidationErrorCount = 1 },
+	}
+	for name, mutate := range cases {
+		e := validEnvelope()
+		mutate(e)
+		if err := validateEnvelope(e); err == nil {
+			t.Fatalf("%s: expected validateEnvelope to fail", name)
+		}
+	}
+
+	// Failures are recorded, not rejected.
+	failed := validEnvelope()
+	failed.Status = "FAILED"
+	failed.Result = nil
+	if err := validateEnvelope(failed); err != nil {
+		t.Fatalf("FAILED envelope must be recorded, not rejected: %v", err)
+	}
+}
diff --git a/research/experiments/phase_i7/cmd/runlistctl/main.go b/research/experiments/phase_i7/cmd/runlistctl/main.go
new file mode 100644
index 0000000..bd3d9d2
--- /dev/null
+++ b/research/experiments/phase_i7/cmd/runlistctl/main.go
@@ -0,0 +1,192 @@
+// Command runlistctl generates and validates Phase I7 R1.2e campaign run
+// lists. It is engineering infrastructure for the preflight: it writes and
+// checks structural run lists only, executes nothing, and enforces the
+// strict global execution ceiling (400 runs), the milestone drift anchors,
+// and the Rule S-1 replacement budget.
+//
+// Usage:
+//
+//	runlistctl generate -out runlist.csv [-catalog cat.json] [-sizing s.json] [-seed 20261101]
+//	runlistctl validate -runlist runlist.csv [-catalog cat.json] [-report report.json]
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"owndbms/research/experiments/phase_i7/runlist"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		usage()
+	}
+	switch os.Args[1] {
+	case "generate":
+		generate(os.Args[2:])
+	case "validate":
+		validate(os.Args[2:])
+	case "ceiling":
+		ceiling(os.Args[2:])
+	default:
+		usage()
+	}
+}
+
+func usage() {
+	fmt.Fprintln(os.Stderr, "usage: runlistctl generate|validate|ceiling [flags] (see -h)")
+	os.Exit(2)
+}
+
+func fs(name string) *flag.FlagSet {
+	fs := flag.NewFlagSet(name, flag.ExitOnError)
+	return fs
+}
+
+func generate(args []string) {
+	f := fs("generate")
+	out := f.String("out", "runlist.csv", "output CSV path")
+	catalogPath := f.String("catalog", "", "optional cell catalog JSON (default: the R1.2e inventory)")
+	sizingPath := f.String("sizing", "", "optional per-cell confirmatory N JSON (default: all cells at N=8)")
+	seed := f.String("seed", "", "master seed override")
+	_ = f.Parse(args)
+
+	catalog := runlist.DefaultCatalog()
+	if *catalogPath != "" {
+		b, err := os.ReadFile(*catalogPath)
+		if err != nil {
+			fatal("read catalog: %v", err)
+		}
+		if err := json.Unmarshal(b, &catalog); err != nil {
+			fatal("parse catalog: %v", err)
+		}
+	}
+	if *seed != "" {
+		catalog.MasterSeed = *seed
+	}
+	sizing := runlist.Sizing{}
+	if *sizingPath != "" {
+		b, err := os.ReadFile(*sizingPath)
+		if err != nil {
+			fatal("read sizing: %v", err)
+		}
+		if err := json.Unmarshal(b, &sizing); err != nil {
+			fatal("parse sizing: %v", err)
+		}
+	}
+
+	rows, err := runlist.Generate(catalog, sizing)
+	if err != nil {
+		fatal("generate: %v", err)
+	}
+	clamped := catalog.ClampSizing(sizing)
+	if dir := filepath.Dir(*out); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			fatal("mkdir: %v", err)
+		}
+	}
+	file, err := os.Create(*out)
+	if err != nil {
+		fatal("create output: %v", err)
+	}
+	defer file.Close()
+	if err := runlist.WriteCSV(file, rows); err != nil {
+		fatal("write: %v", err)
+	}
+	plan := catalog.PlannedRuns(clamped)
+	fmt.Printf("generated %d rows (planned model %d runs, worst case %d, ceiling %d) -> %s\n",
+		len(rows), plan, plan+runlist.ReplacementBudget, runlist.GlobalCeiling, *out)
+}
+
+func validate(args []string) {
+	f := fs("validate")
+	runlistPath := f.String("runlist", "runlist.csv", "run list CSV to validate")
+	catalogPath := f.String("catalog", "", "optional cell catalog JSON (default: the R1.2e inventory)")
+	reportPath := f.String("report", "", "optional JSON report path")
+	_ = f.Parse(args)
+
+	catalog := runlist.DefaultCatalog()
+	if *catalogPath != "" {
+		b, err := os.ReadFile(*catalogPath)
+		if err != nil {
+			fatal("read catalog: %v", err)
+		}
+		if err := json.Unmarshal(b, &catalog); err != nil {
+			fatal("parse catalog: %v", err)
+		}
+	}
+	file, err := os.Open(*runlistPath)
+	if err != nil {
+		fatal("open run list: %v", err)
+	}
+	defer file.Close()
+	rows, err := runlist.ReadCSV(file)
+	if err != nil {
+		fatal("parse run list: %v", err)
+	}
+	rep := runlist.Validate(rows, catalog)
+	if *reportPath != "" {
+		b, _ := json.MarshalIndent(rep, "", "  ")
+		if err := os.WriteFile(*reportPath, append(b, '\n'), 0o644); err != nil {
+			fatal("write report: %v", err)
+		}
+	}
+	for _, e := range rep.Errors {
+		fmt.Fprintf(os.Stderr, "ERROR: %s\n", e)
+	}
+	fmt.Printf("validated %d rows: planned %d (anchors %d), replacements %d, worst case %d, buffer %d, ceiling %d -> %s\n",
+		rep.Total, rep.Planned, rep.D3, rep.Repl, rep.Worst, rep.Buffer, runlist.GlobalCeiling, verdict(rep.OK))
+	if !rep.OK {
+		os.Exit(1)
+	}
+}
+
+// ceiling verifies the campaign execution ledger against the strict global
+// ceiling: every physical execution (pilot, drift anchor, retry, replacement,
+// interrupted, aborted, or successful) counts.
+func ceiling(args []string) {
+	f := fs("ceiling")
+	ledgerPath := f.String("ledger", "results.jsonl", "execution ledger JSONL (STARTED/FINISHED events)")
+	reportPath := f.String("report", "", "optional JSON report path")
+	_ = f.Parse(args)
+
+	file, err := os.Open(*ledgerPath)
+	if err != nil {
+		fatal("open ledger: %v", err)
+	}
+	defer file.Close()
+	records, err := runlist.ParseExecutionLedgerJSONL(file)
+	if err != nil {
+		fatal("parse ledger: %v", err)
+	}
+	rep := runlist.ValidateExecutionLedger(records)
+	if *reportPath != "" {
+		b, _ := json.MarshalIndent(rep, "", "  ")
+		if err := os.WriteFile(*reportPath, append(b, '\n'), 0o644); err != nil {
+			fatal("write report: %v", err)
+		}
+	}
+	for _, e := range rep.Errors {
+		fmt.Fprintf(os.Stderr, "ERROR: %s\n", e)
+	}
+	fmt.Printf("execution ledger: %d physical executions started (%d finished, %d unfinished), replacements/retries %d/%d, remaining under ceiling %d/%d -> %s\n",
+		rep.Started, rep.Finished, rep.Unfinished, rep.ReplRetry, runlist.ReplacementBudget, rep.Remaining, rep.Ceiling, verdict(rep.OK))
+	if !rep.OK {
+		os.Exit(1)
+	}
+}
+
+func verdict(ok bool) string {
+	if ok {
+		return "PASS"
+	}
+	return "FAIL"
+}
+
+func fatal(format string, args ...any) {
+	fmt.Fprintf(os.Stderr, "runlistctl: "+format+"\n", args...)
+	os.Exit(1)
+}
